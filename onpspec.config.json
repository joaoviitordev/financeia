{
  "testCommand": "npx vitest run --reporter=json --outputFile=.spec/verification/raw.json",
  "reporter": "vitest-json",
  "reporterOutputFile": ".spec/verification/raw.json",
  "testGlobs": ["src/**/*.test.*", "src/**/*.spec.*"],
  "srcGlobs": [
    "src/routes/**",
    "src/features/simulations/**",
    "src/features/insights/**",
    "src/server/**",
    "src/router.tsx",
    "api/**"
  ],
  "ignoreGlobs": ["node_modules/**", ".git/**", "dist/**", "build/**", "coverage/**", ".spec/**"]
}
